# AI-eat 环境变量示例：复制为 .env 后按需填写（.env 已被 .gitignore 忽略，不会入库）
# 以下环境变量均可按需设置：三项 AI 配置齐备时 /api/config 的 aiConfigured 才为 true；
# 缺省时应用仍可正常使用手动菜谱/备份等本地功能，仅 AI 生成与点菜不可用

# AI 供应商 OpenAI 兼容接口地址（如 https://api.example.com/v1）
AI_BASE_URL=

# AI 供应商 API Key（仅服务端读取，任何接口都不会回显该值）
AI_API_KEY=

# 模型名（按供应商填写，如 deepseek-chat 等）
AI_MODEL=

# AI 温度分层（全部可选，非法值自动回落默认并限制在 0~1）：
# chat=0.7（问问AI，兼顾清单与完整菜谱）、menu=0.8（买什么菜单偏创意）、
# recipe=0.7（完整菜谱结构稳定）、nutrition=0.5（营养估算求稳）
AI_TEMP_CHAT=
AI_TEMP_MENU=
AI_TEMP_RECIPE=
AI_TEMP_NUTRITION=

# 访问口令：非空即启用登录鉴权（局域网部署建议设置）；留空则免登录直接访问
PASSWORD=

# 删除保护（可选）：DELETE_ENABLED=true 且 DELETE_PASSWORD 非空时同时满足才启用——
# 删除菜谱需输入 DELETE_PASSWORD，服务端恒时校验（403 拒绝）；两项任一缺失则仅浏览器确认即可删除
DELETE_ENABLED=
DELETE_PASSWORD=

# 另有 AI_EAT_DATA_DIR 控制数据目录：该变量特指「菜谱库目录」（data/recipes 的位置），
# 访问日志固定落在其父目录下的 logs/ 子目录（即 data/logs/access.jsonl），与菜谱库同级、同受数据卷保护。
# Docker 部署由 docker-compose.yml 固定注入 /app/data/recipes（对应挂载 ./data:/app/data），
# 裸机无需设置，一般不用改
AI_EAT_DATA_DIR=
